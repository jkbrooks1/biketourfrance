---
// Shown on staging only. Production launch requires the owner to resolve the items listed in
// docs/PRODUCTION_CUTOVER_PREFLIGHT.md, after which indexingEnabled is switched on and this note disappears.
import Copy from './Copy.astro';
import { SITE } from '../data/site';
import { has } from '../lib/copy.mjs';
---

{!SITE.indexingEnabled && has('site/review_note') && (
  <div class="review-note" role="note">
    <Copy field="site/review_note" inline />
  </div>
)}
