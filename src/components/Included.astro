---
import { TEXT } from '../data/approved-copy';
// The "What is included / What you arrange separately" statement for the CDM page.
import { CDM_FACTS, INCLUDED, SEPARATE } from '../data/cdm2027';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const SubHeading = headingLevel === 'h2' ? 'h3' : 'h4';
---

<div class="included">
  <Heading>{TEXT['/ui-included/frag_1']}</Heading>
  <div class="notice">
    <p>
      <strong>{TEXT['/cdm/frag_2']}</strong> {CDM_FACTS.datesNote} {CDM_FACTS.pricingNote}
    </p>
  </div>
  <div class="two-col two-col--spaced">
    <div class="card">
      <SubHeading>{TEXT['/ui-included/frag_2']}</SubHeading>
      <ul>
        {INCLUDED.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <div class="card">
      <SubHeading>{TEXT['/ui-included/frag_3']}</SubHeading>
      <ul>
        {SEPARATE.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </div>
</div>
