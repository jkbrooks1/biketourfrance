---
// The "What is included / what you arrange separately" statement. Used on the home page and the CDM
// page, each with its own approved fields (kept identical by a consistency rule in
// copy/consistency-rules.json).
import Copy from './Copy.astro';
import { t } from '../lib/copy.mjs';

interface Props {
  headingField: string;
  noticeField: string;
  includedLabelField: string;
  includedField: string;
  separateLabelField: string;
  separateField: string;
}
const { headingField, noticeField, includedLabelField, includedField, separateLabelField, separateField } =
  Astro.props;
---

<div class="included">
  <h2>{t(headingField)}</h2>
  <div class="notice">
    <Copy field={noticeField} />
  </div>
  <div class="two-col" style="margin-top: 1.5rem">
    <div class="card">
      <h3>{t(includedLabelField)}</h3>
      <Copy field={includedField} />
    </div>
    <div class="card">
      <h3>{t(separateLabelField)}</h3>
      <Copy field={separateField} />
    </div>
  </div>
</div>
