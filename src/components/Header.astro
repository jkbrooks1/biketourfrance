---
// Site header band: full-width green, logo left, navigation right. 72px desktop, 64px tablet, 56px mobile.
// The same header is used on every page through BaseLayout.
import { Image } from 'astro:assets';
import logo from '../assets/brand/btf-logo-white.png';
import { NAV, SITE, currentNavHref } from '../data/site';

interface Props {
  path: string;
}
const { path } = Astro.props;
const current = currentNavHref(path);
---

<header class="site-header">
  <div class="band__inner site-header__bar">
    <a class="brand" href="/">
      <Image
        class="brand__logo"
        src={logo}
        alt="BikeTourFrance.net logo: a bicycle over a map of France"
        width={96}
        height={96}
        loading="eager"
      />
      <span class="brand__name">{SITE.name}</span>
    </a>
    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>
    <nav class="site-nav" id="site-nav" data-nav data-open="true" aria-label="Main">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>
