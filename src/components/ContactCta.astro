---
import { CONTACT_LINKS, SITE } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Ready to ride?',
  text = 'Email John with your questions, or ask to be added to the 2027 waitlist. He answers every message himself.',
} = Astro.props;
---

<section class="section section--cta" aria-labelledby="cta-heading">
  <div class="container">
    <h2 id="cta-heading">{heading}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <a class="btn" href={CONTACT_LINKS.waitlist}>
        Ask to join the 2027 waitlist
      </a>
      <a class="btn btn--secondary" href={CONTACT_LINKS.general}>
        Email {SITE.email}
      </a>
    </div>
  </div>
</section>
