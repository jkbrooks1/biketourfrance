---
// Closing call-to-action band. Heading and body are approved copy fields chosen by the page;
// the two button labels are shared (site/cta_waitlist_label, site/cta_email_label).
import Copy from './Copy.astro';
import { CONTACT_LINKS } from '../data/site';
import { t } from '../lib/copy.mjs';

interface Props {
  headingField: string;
  bodyField: string;
}
const { headingField, bodyField } = Astro.props;
---

<section class="section section--cta" aria-labelledby="cta-heading">
  <div class="container">
    <h2 id="cta-heading">{t(headingField)}</h2>
    <Copy field={bodyField} />
    <div class="btn-row">
      <a class="btn" href={CONTACT_LINKS.waitlist}>
        {t('site/cta_waitlist_label')}
      </a>
      <a class="btn btn--secondary" href={CONTACT_LINKS.general}>
        {t('site/cta_email_label')}
      </a>
    </div>
  </div>
</section>
