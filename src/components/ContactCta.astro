---
// Closing call to action. The site has no sign-up form, so both buttons open an email to John.
import Button from './Button.astro';
import { COPY } from '../data/approved-copy';
import { CONTACT_LINKS } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Questions about a tour?',
  text = 'Email John with your questions, or ask to be added to the 2027 waitlist.',
} = Astro.props;
---

<section class="section section--cta" aria-labelledby="cta-heading">
  <div class="container">
    <h2 id="cta-heading">{heading}</h2>
    <p>{text}</p>
    <div class="btn-row">
      <Button href={CONTACT_LINKS.general}>{COPY.contact.emailCta}</Button>
      <Button href={CONTACT_LINKS.waitlist} variant="secondary">
        {COPY.hero.waitlistCta}
      </Button>
    </div>
  </div>
</section>
