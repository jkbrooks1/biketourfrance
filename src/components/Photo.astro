---
// One place for image delivery: AVIF and WebP with responsive widths. Below-the-fold images lazy-load;
// pass priority for the single hero image so it loads first.
// ratio reserves a shaped picture container; the image fills it with a crop that preserves its proportions.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  quality?: number;
  ratio?: '16:9' | '4:3' | '1:1' | '3:4';
  class?: string;
}
const {
  src,
  alt,
  sizes = '(min-width: 1344px) 1280px, calc(100vw - 40px)',
  widths = [480, 800, 1200],
  priority = false,
  quality = 62,
  ratio,
  class: className,
} = Astro.props;
const usable = widths.filter((w) => w <= src.width);
const ratioClass = ratio ? `ratio-${ratio.replace(':', 'x')}` : undefined;
---

<Picture
  src={src}
  alt={alt}
  widths={usable.length ? usable : [src.width]}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  quality={quality}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  pictureAttributes={{ class: ratio ? `photo-crop ${ratioClass}` : undefined }}
  class={className}
/>
