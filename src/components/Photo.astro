---
// One place for image delivery: AVIF and WebP with responsive widths. Below-the-fold images lazy-load;
// pass priority for the single hero image so it loads first.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  class?: string;
}
const {
  src,
  alt,
  sizes = '(min-width: 1120px) 1040px, 92vw',
  widths = [480, 800, 1200, 1600],
  priority = false,
  class: className,
} = Astro.props;
const usable = widths.filter((w) => w <= src.width);
---

<Picture
  src={src}
  alt={alt}
  widths={usable.length ? usable : [src.width]}
  sizes={sizes}
  formats={['avif', 'webp']}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
  class={className}
/>
