---
// Site footer band: full-width green, logo (40px), navigation, contact, and the approved legal copy at 14px or larger.
import { Image } from 'astro:assets';
import logo from '../assets/brand/btf-logo-white.png';
import { COPY, footerPolicyParts, TEXT } from '../data/approved-copy';
import { CONTACT_LINKS, FOOTER_TOUR_LINKS, LEGAL_NAV, NAV, SITE } from '../data/site';

interface Props {
  buildTimestamp: string;
  buildTimeIso: string;
}
const { buildTimestamp, buildTimeIso } = Astro.props;
const policies = footerPolicyParts();
---

<footer class="site-footer">
  <div class="band__inner">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__brand">
          <Image
            class="site-footer__logo"
            src={logo}
            alt={TEXT['/footer-ui/alt_1']}
            width={80}
            height={80}
            loading="lazy"
          />
          <span>{SITE.name}</span>
        </p>
        <p>{COPY.smallCommercialBottom}</p>
        <p>
          <a class="footer-link" href={CONTACT_LINKS.general}>
            {COPY.contact.contactEmail}
          </a>
        </p>
      </div>
      <nav aria-label="Site">
        <h2>{COPY.footerNav.exploreHeading}</h2>
        <ul>
          {NAV.map((item) => (
            <li>
              <a class="footer-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
          {FOOTER_TOUR_LINKS.map((item) => (
            <li>
              <a class="footer-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label={TEXT['/footer/nav_legal_heading']}>
        <h2>{COPY.footerNav.legalHeading}</h2>
        <ul>
          {LEGAL_NAV.map((item) => (
            <li>
              <a class="footer-link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="site-footer__legal">
      {policies.map((part) => (
        <p>
          <strong>{part.label}:</strong> {part.text}
        </p>
      ))}
      <p class="site-footer__copyright">{COPY.copyright}</p>
      <p class="site-footer__updated">
        <time datetime={buildTimeIso}>{buildTimestamp}</time>
      </p>
    </div>
  </div>
</footer>
