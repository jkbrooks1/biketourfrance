---
import { Image } from 'astro:assets';
import logo from '../assets/brand/btf-logo-white.png';
import { CONTACT_LINKS, LEGAL_NAV, NAV } from '../data/site';
import { t } from '../lib/copy.mjs';
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__brand">
          <Image src={logo} alt="" width={48} height={48} loading="lazy" />
          <span>{t('site/brand_name')}</span>
        </p>
        <p>{t('site/footer_tagline')}</p>
        <p>
          <a href={CONTACT_LINKS.general}>{t('site/footer_email')}</a>
        </p>
      </div>
      <nav aria-label="Site">
        <h2>{t('site/footer_explore_heading')}</h2>
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href}>{t(item.field)}</a>
            </li>
          ))}
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2>{t('site/footer_legal_heading')}</h2>
        <ul>
          {LEGAL_NAV.map((item) => (
            <li>
              <a href={item.href}>{t(item.field)}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <small>{t('site/footer_copyright')}</small>
  </div>
</footer>
