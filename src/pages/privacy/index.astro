---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Copy from '../../components/Copy.astro';
import ReviewNote from '../../components/ReviewNote.astro';
import { t } from '../../lib/copy.mjs';
---

<BaseLayout path="/privacy/" title={t('privacy/seo_title')} description={t('privacy/seo_description')}>
  <section class="section">
    <div class="container prose">
      <h1>{t('privacy/page_heading')}</h1>
      <Copy field="privacy/page_lede" class="lede" />
      <ReviewNote />
      <Copy field="privacy/page_copy" />
    </div>
  </section>
</BaseLayout>
