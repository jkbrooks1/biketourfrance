---
import { TEXT } from '../../data/approved-copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewNote from '../../components/ReviewNote.astro';
import { CONTACT_LINKS, SITE } from '../../data/site';
---

<BaseLayout
  path="/privacy/"
  title={TEXT['/nav/privacy']}
  description={TEXT['/privacy/meta_description']}
>
  <section class="section">
    <div class="container prose">
      <h1>{TEXT['/nav/privacy']}</h1>
      <p class="lede">{TEXT['/privacy/body_1']}</p>
      <ReviewNote />

      <h2>{TEXT['/privacy/heading_1']}</h2>
      <p>
        {TEXT['/privacy/frag_1']} <a href="/cookies/">{TEXT['/privacy/frag_2']}</a>.
      </p>

      <h2>{TEXT['/privacy/heading_2']}</h2>
      <p>
        {TEXT['/privacy/frag_3']} <a href={CONTACT_LINKS.general}>{SITE.email}</a>{TEXT['/privacy/frag_4']}
      </p>

      <h2>{TEXT['/privacy/heading_3']}</h2>
      <p>{TEXT['/privacy/body_2']}</p>

      <h2>{TEXT['/privacy/heading_4']}</h2>
      <p>{TEXT['/privacy/body_3']}</p>

      <h2>{TEXT['/privacy/heading_5']}</h2>
      <p>
        {TEXT['/contact-page/frag_1']} <a href={CONTACT_LINKS.general}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
