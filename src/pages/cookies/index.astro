---
import { TEXT } from '../../data/approved-copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewNote from '../../components/ReviewNote.astro';
---

<BaseLayout
  path="/cookies/"
  title={TEXT['/nav/cookies']}
  description={TEXT['/cookies/meta_description']}
>
  <section class="section">
    <div class="container prose">
      <h1>{TEXT['/nav/cookies']}</h1>
      <p class="lede">{TEXT['/cookies/body_1']}</p>
      <ReviewNote />

      <h2>{TEXT['/cookies/heading_1']}</h2>
      <p>{TEXT['/cookies/body_2']}</p>

      <h2>{TEXT['/cookies/heading_2']}</h2>
      <p>{TEXT['/cookies/body_3']}</p>

      <h2>{TEXT['/cookies/heading_3']}</h2>
      <p>{TEXT['/cookies/body_4']}</p>
    </div>
  </section>
</BaseLayout>
