---
import { TEXT } from '../data/approved-copy';
import BaseLayout from '../layouts/BaseLayout.astro';

// 2027 Tour Waitlist staging page. It POSTs the governed JSON contract to the
// inactive T06 test webhook. No build-time data fetching and no production intake.
const webhookUrl = 'https://n8n.biketourfrance.net/webhook-test/btf-waitlist-2027-intake';

const consentNotice = TEXT['/waitlist/consent_notice'];

const pageTitle = TEXT['/waitlist/meta_title'];
const pageDescription = TEXT['/waitlist/meta_description'];
const pagePath = '/waitlist-2027/';
---

<BaseLayout title={pageTitle} description={pageDescription} path={pagePath}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <style>
    .waitlist-hero {
      background: var(--green);
      color: #fff;
      text-align: center;
      padding: 48px 24px 48px;
    }
    .waitlist-hero h1 { font-size: 40px; line-height: 1.15; margin: 0 auto 16px; max-width: 760px; }
    .waitlist-hero p { font-size: 18px; line-height: 1.5; margin: 0 auto; max-width: 620px; }
    .waitlist-container {
      flex: 1;
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
      padding: 40px 24px 64px;
    }
    .waitlist-intro { font-size: 17px; line-height: 1.6; margin: 0 0 24px; }
    .waitlist-form { display: block; }
    .waitlist-field { margin: 0 0 16px; }
    .waitlist-label, .waitlist-legend { display: block; font-weight: 600; font-size: 15px; margin: 0 0 8px; padding: 0; }
    .waitlist-input {
      width: 100%;
      font: inherit;
      font-size: 16px;
      padding: 12px 16px;
      border: 1px solid #c9cfc2;
      border-radius: 4px;
      background: #fff;
      color: #1c1c1c;
    }
    .waitlist-input:focus-visible {
      outline: 2px solid var(--green);
      outline-offset: 2px;
    }
    .waitlist-fieldset { border: 0; margin: 0 0 16px; padding: 0; }
    .waitlist-choice { display: flex; align-items: center; gap: 8px; padding: 8px 0; font-size: 16px; font-weight: 400; }
    .waitlist-choice input { width: 20px; height: 20px; margin: 0; accent-color: var(--green); flex: none; }
    .waitlist-choice label { margin: 0; font-weight: 400; font-size: 16px; }
    .waitlist-error { color: #9b1c1c; font-size: 14px; margin: 8px 0 0; min-height: 0; }
    .waitlist-input[aria-invalid="true"] { border-color: #9b1c1c; }
    .waitlist-notice { font-size: 13px; line-height: 1.5; color: #444; margin: 8px 0 16px; }
    .waitlist-button {
      display: block;
      width: 100%;
      padding: 12px 24px;
      border: 0;
      border-radius: 4px;
      background: var(--green);
      color: #fff;
      font: inherit;
      font-size: 17px;
      font-weight: 600;
      cursor: pointer;
      min-height: 44px;
    }
    .waitlist-button:hover { background: #1f3a0f; }
    .waitlist-button:disabled { opacity: 0.6; cursor: not-allowed; }
    .waitlist-button:focus-visible {
      outline: 2px solid var(--green);
      outline-offset: 4px;
    }
    .waitlist-status { margin: 16px 0 0; font-size: 15px; line-height: 1.5; }
    .waitlist-status.error { color: #9b1c1c; }
    .waitlist-success {
      background: #f4f1ea;
      border-left: 4px solid var(--green);
      padding: 24px;
      border-radius: 4px;
    }
    .waitlist-success h2 { margin: 0 0 8px; font-size: 22px; color: var(--green); }
    .waitlist-success p { margin: 0; font-size: 16px; line-height: 1.6; }
    .waitlist-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
    [hidden] { display: none !important; }
  </style>

  <section class="waitlist-hero">
    <h1>{TEXT['/waitlist/heading_1']}</h1>
    <p>{TEXT['/waitlist/body_1']}</p>
  </section>

  <div class="waitlist-container">
    <p class="waitlist-intro">{TEXT['/waitlist/body_2']}</p>

    <div id="success" class="waitlist-success" role="status" tabindex="-1" hidden>
      <h2>{TEXT['/waitlist/heading_2']}</h2>
      <p>{TEXT['/waitlist/body_3']}</p>
    </div>

    <form id="waitlist-form" class="waitlist-form" novalidate data-endpoint={webhookUrl}>
      <div class="waitlist-field">
        <label class="waitlist-label" for="first_name">{TEXT['/waitlist/label_1']}</label>
        <input class="waitlist-input" type="text" id="first_name" name="first_name" autocomplete="given-name" maxlength="80" required aria-describedby="first_name-error" />
        <p class="waitlist-error" id="first_name-error" aria-live="polite"></p>
      </div>

      <div class="waitlist-field">
        <label class="waitlist-label" for="email">{TEXT['/waitlist/frag_1']}</label>
        <input class="waitlist-input" type="email" id="email" name="email" autocomplete="email" inputmode="email" maxlength="254" required aria-describedby="email-error" />
        <p class="waitlist-error" id="email-error" aria-live="polite"></p>
      </div>

      <fieldset class="waitlist-fieldset" aria-describedby="tour_interest-error">
        <legend class="waitlist-legend">{TEXT['/waitlist/frag_2']}</legend>
        <div class="waitlist-choice"><input type="radio" id="interest-spring" name="tour_interest" value="Spring 2027" required /><label class="waitlist-choice-label" for="interest-spring">{TEXT['/waitlist/frag_3']}</label></div>
        <div class="waitlist-choice"><input type="radio" id="interest-fall" name="tour_interest" value="Fall 2027" /><label class="waitlist-choice-label" for="interest-fall">{TEXT['/waitlist/frag_4']}</label></div>
        <div class="waitlist-choice"><input type="radio" id="interest-either" name="tour_interest" value="Either" /><label class="waitlist-choice-label" for="interest-either">{TEXT['/waitlist/label_2']}</label></div>
        <p class="waitlist-error" id="tour_interest-error" aria-live="polite"></p>
      </fieldset>

      <input type="hidden" name="offer_id" value="btf-2027-tours-waitlist" />
      <input type="hidden" name="marketing_consent" value="true" />
      <input type="hidden" name="consent_version" value="btf-marketing-consent-v1" />
      <input type="hidden" name="source" value="biketourfrance.net-waitlist" />

      <div class="waitlist-hp" aria-hidden="true">
        <label class="waitlist-label" for="company_website">{TEXT['/waitlist/label_4']}</label>
        <input class="waitlist-input" type="text" id="company_website" name="company_website" tabindex="-1" autocomplete="off" />
      </div>

      <p class="waitlist-notice" id="consent-notice">{consentNotice}</p>
      <button type="submit" class="waitlist-button" id="submit-button">{TEXT['/waitlist/cta_1']}</button>
      <p class="waitlist-status" id="form-status" role="status" aria-live="polite"></p>
    </form>

  <script is:inline>
    (function () {
      var form = document.getElementById('waitlist-form');
      var button = document.getElementById('submit-button');
      var statusEl = document.getElementById('form-status');
      var success = document.getElementById('success');
      var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

      function setError(id, message) {
        var el = document.getElementById(id + '-error');
        if (el) el.textContent = message || '';
        var input = document.getElementById(id);
        if (input) {
          if (message) input.setAttribute('aria-invalid', 'true');
          else input.removeAttribute('aria-invalid');
        }
      }

      function validate() {
        var ok = true;
        var firstName = form.elements.first_name.value.trim();
        var email = form.elements.email.value.trim();
        var tourInterest = form.querySelector('input[name="tour_interest"]:checked');
        setError('first_name', firstName ? '' : 'Please enter your first name.');
        setError('email', emailPattern.test(email) && email.length <= 254 ? '' : 'Please enter a valid email address.');
        document.getElementById('tour_interest-error').textContent = tourInterest ? '' : 'Please choose Spring 2027, Fall 2027, or Either.';
        if (!firstName || !emailPattern.test(email) || email.length > 254 || !tourInterest) ok = false;
        return ok;
      }

      form.addEventListener('submit', function (event) {
        event.preventDefault();
        statusEl.textContent = '';
        statusEl.className = 'waitlist-status';
        if (!validate()) {
          var firstInvalid = form.querySelector('[aria-invalid="true"]') || form.querySelector('input[name="tour_interest"]');
          if (firstInvalid) firstInvalid.focus();
          return;
        }

        var payload = {
          first_name: form.elements.first_name.value.trim(),
          email: form.elements.email.value.trim(),
          offer_id: form.elements.offer_id.value,
          tour_interest: form.querySelector('input[name="tour_interest"]:checked').value,
          source: form.elements.source.value,
          marketing_consent: form.elements.marketing_consent.value === 'true',
          consent_version: form.elements.consent_version.value,
          company_website: form.elements.company_website.value
        };

        button.disabled = true;
        button.textContent = 'Joining...';

        fetch(form.getAttribute('data-endpoint'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (response) {
            return response.json().catch(function () { return {}; }).then(function (data) {
              return { ok: response.ok, data: data };
            });
          })
          .then(function (result) {
            if (result.ok && result.data && result.data.ok) {
              form.hidden = true;
              success.hidden = false;
              success.focus();
              return;
            }
            var message = (result.data && result.data.error) || 'Something went wrong. Please try again.';
            statusEl.textContent = message;
            statusEl.className = 'waitlist-status error';
            button.disabled = false;
            button.textContent = 'Join the 2027 Waitlist';
          })
          .catch(function () {
            statusEl.textContent = 'We could not reach the server. Please check your connection and try again.';
            statusEl.className = 'waitlist-status error';
            button.disabled = false;
            button.textContent = 'Join the 2027 Waitlist';
          });
      });
    })();
  </script>
  </div>
</BaseLayout>
