---
import { TEXT } from '../../data/approved-copy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewNote from '../../components/ReviewNote.astro';
import { CONTACT_LINKS, SITE } from '../../data/site';
---

<BaseLayout
  path="/terms/"
  title={TEXT['/nav/terms']}
  description={TEXT['/terms/meta_description']}
>
  <section class="section">
    <div class="container prose">
      <h1>{TEXT['/nav/terms']}</h1>
      <p class="lede">{TEXT['/terms/body_1']}</p>
      <ReviewNote />

      <h2>{TEXT['/terms/heading_1']}</h2>
      <p>{TEXT['/terms/body_2']}</p>

      <h2>{TEXT['/terms/heading_2']}</h2>
      <p>{TEXT['/terms/body_3']}</p>

      <h2>{TEXT['/terms/heading_3']}</h2>
      <p>{TEXT['/terms/body_4']}</p>

      <h2>{TEXT['/terms/heading_4']}</h2>
      <p>{TEXT['/terms/body_5']}</p>

      <h2>{TEXT['/nav/contact']}</h2>
      <p>
        {TEXT['/contact-page/frag_1']} <a href={CONTACT_LINKS.general}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
