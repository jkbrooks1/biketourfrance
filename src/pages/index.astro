---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Copy from '../components/Copy.astro';
import Included from '../components/Included.astro';
import Gallery from '../components/Gallery.astro';
import ContactCta from '../components/ContactCta.astro';
import { GALLERY, PHOTOS } from '../data/photos';
import { CONTACT_LINKS } from '../data/site';
import { t } from '../lib/copy.mjs';
---

<BaseLayout home path="/" title={t('home/seo_title')} description={t('home/seo_description')}>
  <section class="hero">
    <div class="hero__media">
      <Photo
        src={PHOTOS.hero.src}
        alt={PHOTOS.hero.alt}
        priority
        widths={[640, 960, 1440, 2000]}
        sizes="100vw"
      />
    </div>
    <div class="container hero__body">
      <p class="eyebrow">{t('home/hero_eyebrow')}</p>
      <h1>{t('home/hero_heading')}</h1>
      <Copy field="home/hero_body" class="lede" />
      <div class="btn-row">
        <a class="btn" href="/canal-des-deux-mers/">
          {t('home/hero_cta_tour')}
        </a>
        <a class="btn btn--secondary" href={CONTACT_LINKS.waitlist}>
          {t('home/tour_waitlist_cta')}
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ways-heading">
    <div class="container">
      <h2 id="ways-heading">{t('home/ways_heading')}</h2>
      <div class="two-col">
        <div class="card">
          <h3>{t('home/ways_group_heading')}</h3>
          <Copy field="home/ways_group_body" />
          <p>
            <a href="/canal-des-deux-mers/">{t('home/ways_group_link')}</a>
          </p>
        </div>
        <div class="card">
          <h3>{t('home/ways_own_heading')}</h3>
          <Copy field="home/ways_own_body" />
          <p>
            <a href={CONTACT_LINKS.planning}>{t('home/ways_own_link')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="cdm-heading">
    <div class="container split">
      <div>
        <p class="eyebrow">{t('home/cdm_eyebrow')}</p>
        <h2 id="cdm-heading">{t('home/cdm_heading')}</h2>
        <Copy field="home/cdm_summary" />
        <Copy field="home/cdm_stats" listClass="stats" />
        <Copy field="home/cdm_departures" />
        <div class="btn-row">
          <a class="btn" href="/canal-des-deux-mers/">
            {t('home/cdm_cta')}
          </a>
        </div>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.twoRidersShade.src}
          alt={PHOTOS.twoRidersShade.alt}
          sizes="(min-width: 820px) 45vw, 92vw"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Included
        headingField="home/whats_included_heading"
        noticeField="home/whats_included_notice"
        includedLabelField="home/whats_included_label"
        includedField="home/whats_included"
        separateLabelField="home/what_you_arrange_separately_label"
        separateField="home/what_you_arrange_separately"
      />
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="about-heading">
    <div class="container split split--reverse">
      <div>
        <p class="eyebrow">{t('home/about_eyebrow')}</p>
        <h2 id="about-heading">{t('home/about_heading')}</h2>
        <Copy field="home/about_body" />
        <p>
          <a href="/about/">{t('home/about_link')}</a>
        </p>
      </div>
      <div class="rounded">
        <Photo src={PHOTOS.cafeTable.src} alt={PHOTOS.cafeTable.alt} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-heading">
    <div class="container">
      <h2 id="gallery-heading">{t('home/gallery_heading')}</h2>
      <Gallery photos={GALLERY.slice(0, 8)} />
      <p style="margin-top: 1rem">
        <a href="/canal-des-deux-mers/#gallery-heading">{t('home/gallery_link')}</a>
      </p>
    </div>
  </section>

  <ContactCta headingField="home/ready_to_ride_heading" bodyField="home/contact_cta" />
</BaseLayout>
