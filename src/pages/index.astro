---
// Build cache bust
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Button from '../components/Button.astro';
import Gallery from '../components/Gallery.astro';
import { COPY, TEXT } from '../data/approved-copy';
import { GALLERY, PHOTOS } from '../data/photos';
import { CONTACT_LINKS } from '../data/site';

const { hero, readyToRide, about, gallery, buttons } = COPY;
---

<BaseLayout
  home
  path="/"
  title={TEXT['/meta_title']}
  description={COPY.metaDescription}
>
  <section class="hero">
    <div class="hero__media">
      <Photo
        src={PHOTOS.hero.src}
        alt={PHOTOS.hero.alt}
        priority
        widths={[640, 960, 1280]}
        quality={50}
        sizes="100vw"
      />
    </div>
    <div class="container hero__body">
      <h1>{hero.heading}</h1>
      <p>{hero.body1}</p>
      <p>{hero.body2}</p>
      <div class="btn-row">
        <Button href={CONTACT_LINKS.waitlist}>{hero.waitlistCta}</Button>
        <Button href={CONTACT_LINKS.mailingList} variant="secondary">
          {hero.mailingListCta}
        </Button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ready-heading">
    <div class="container split">
      <div class="ready__body">
        <h2 id="ready-heading">{readyToRide.heading}</h2>
        <p class="lede">{readyToRide.summary1}</p>
        <p>{readyToRide.summary2}</p>
        <ul>
          <li>{readyToRide.summary3}</li>
          <li>{readyToRide.summary4}</li>
        </ul>
        <p class="ready__facts">{readyToRide.rideFacts}</p>
        <h3>{readyToRide.includedHeading}</h3>
        <ul>
          {readyToRide.included.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.twoRidersShade.src}
          alt={PHOTOS.twoRidersShade.alt}
          ratio="1:1"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="cdm-heading">
    <div class="container split split--reverse">
      <div>
        <h2 id="cdm-heading">{readyToRide.cdmHeading}</h2>
        <p class="lede">
          {readyToRide.cdmLines[0]}
          <br />
          {readyToRide.cdmLines[1]}
        </p>
        <div class="btn-row">
          <Button href="/canal-des-deux-mers/">{readyToRide.cdmCta}</Button>
        </div>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.riderCanalPath.src}
          alt={PHOTOS.riderCanalPath.alt}
          ratio="3:4"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-heading">
    <div class="container split">
      <div>
        <h2 id="about-heading">{about.heading}</h2>
        <p class="lede">{about.subheading}</p>
        <p>{about.body1}</p>
        <p>{about.body2}</p>
        <p>{about.body3}</p>
        <div class="btn-row">
          <Button href="/about/" variant="secondary">
            {buttons.readMoreAboutJohn}
          </Button>
        </div>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.aboutJohn.src}
          alt={PHOTOS.aboutJohn.alt}
          ratio="1:1"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section testimonials" id="testimonials" aria-labelledby="testimonials-heading">
    <div class="container">
      <h2 id="testimonials-heading">{TEXT['/home-testimonials/heading']}</h2>
      <ul class="testimonials__list">
        {[1, 2, 3].map((n) => (
          <li>
            <figure class="testimonial">
              <blockquote class="testimonial__quote">
                <p>{TEXT[`/home-testimonials/quote_${n}`]}</p>
              </blockquote>
              <figcaption class="testimonial__source">
                <span class="testimonial__author">{TEXT[`/home-testimonials/author_${n}`]}</span>
                <span class="testimonial__context">{TEXT[`/home-testimonials/context_${n}`]}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="testimonials__cta">
        <a href={CONTACT_LINKS.waitlist}>{TEXT['/home-testimonials/cta']}</a>
      </p>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="gallery-heading">
    <div class="container">
      <h2 id="gallery-heading">{gallery.heading}</h2>
      <Gallery photos={GALLERY.slice(0, 8)} />
      <div class="btn-row">
        <Button href="/cdm-photo-gallery/" variant="tertiary">
          {buttons.moreTourPhotos}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
