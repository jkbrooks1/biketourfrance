---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import Copy from '../../components/Copy.astro';
import ContactCta from '../../components/ContactCta.astro';
import { PHOTOS } from '../../data/photos';
import { CONTACT_LINKS } from '../../data/site';
import { t } from '../../lib/copy.mjs';
---

<BaseLayout path="/tours/" title={t('tours/seo_title')} description={t('tours/seo_description')}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t('tours/page_eyebrow')}</p>
      <h1>{t('tours/page_heading')}</h1>
      <Copy field="tours/page_lede" class="lede" />
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="group-heading">
    <div class="container split">
      <div>
        <h2 id="group-heading">{t('tours/group_heading')}</h2>
        <Copy field="tours/group_body" />
        <div class="btn-row">
          <a class="btn" href="/canal-des-deux-mers/">
            {t('tours/group_cta')}
          </a>
          <a class="btn btn--secondary" href={CONTACT_LINKS.waitlist}>
            {t('tours/group_waitlist_cta')}
          </a>
        </div>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.riderCanalPath.src}
          alt={PHOTOS.riderCanalPath.alt}
          priority
          sizes="(min-width: 820px) 45vw, 92vw"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="self-guided-heading">
    <div class="container">
      <h2 id="self-guided-heading">{t('tours/self_guided_heading')}</h2>
      <Copy field="tours/self_guided_body" />
      <p>
        <a class="btn btn--secondary" href={CONTACT_LINKS.planning}>
          {t('tours/self_guided_cta')}
        </a>
      </p>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="coaching-heading">
    <div class="container">
      <h2 id="coaching-heading">{t('tours/coaching_heading')}</h2>
      <Copy field="tours/coaching_body" />
      <p>
        <a class="btn btn--secondary" href={CONTACT_LINKS.planning}>
          {t('tours/coaching_cta')}
        </a>
      </p>
    </div>
  </section>

  <ContactCta headingField="tours/ready_to_ride_heading" bodyField="tours/contact_cta" />
</BaseLayout>
