---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import Button from '../../components/Button.astro';
import { COPY, TEXT } from '../../data/approved-copy';
import { CDM_FACTS } from '../../data/cdm2027';
import { PHOTOS } from '../../data/photos';
import { CONTACT_LINKS } from '../../data/site';
---

<BaseLayout
  path="/tours/"
  title={TEXT['/tours/meta_title']}
  description={TEXT['/tours/meta_description']}
  ogImage={PHOTOS.riderCanalPath.src}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{TEXT['/nav/tours']}</p>
      <h1>{TEXT['/tours/heading_1']}</h1>
      <p class="lede">{TEXT['/tours/body_1']}</p>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="group-heading">
    <div class="container split">
      <div>
        <h2 id="group-heading">{TEXT['/tours/heading_2']}</h2>
        <p>{CDM_FACTS.route}</p>
        <p>
          {CDM_FACTS.departures} {CDM_FACTS.datesNote} {CDM_FACTS.pricingNote}
        </p>
        <div class="btn-row">
          <Button href="/canal-des-deux-mers/">{TEXT['/tours/cta_1']}</Button>
          <Button href={CONTACT_LINKS.waitlist} variant="secondary">
            {COPY.hero.waitlistCta}
          </Button>
        </div>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.riderCanalPath.src}
          alt={PHOTOS.riderCanalPath.alt}
          priority
          ratio="3:4"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="self-guided-heading">
    <div class="container">
      <h2 id="self-guided-heading">{TEXT['/tours/frag_1']}</h2>
      <p>{TEXT['/tours/body_2']}</p>
      <p>{TEXT['/tours/body_3']}</p>
      <div class="btn-row">
        <Button href={CONTACT_LINKS.planning} variant="secondary">{TEXT['/tours/cta_2']}</Button>
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="coaching-heading">
    <div class="container">
      <h2 id="coaching-heading">{TEXT['/tours/heading_3']}</h2>
      <p>{TEXT['/tours/body_4']}</p>
      <div class="btn-row">
        <Button href={CONTACT_LINKS.planning} variant="secondary">{TEXT['/tours/cta_3']}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
