---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Copy from '../../components/Copy.astro';
import LinkList from '../../components/LinkList.astro';
import AudioList from '../../components/AudioList.astro';
import ContactCta from '../../components/ContactCta.astro';
import { t } from '../../lib/copy.mjs';
---

<BaseLayout path="/resources/" title={t('resources/seo_title')} description={t('resources/seo_description')}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t('resources/page_eyebrow')}</p>
      <h1>{t('resources/page_heading')}</h1>
      <Copy field="resources/intro_copy" class="lede" />
      <Copy field="resources/page_nav" />
    </div>
  </section>

  <section class="section section--beige" id="templates" aria-labelledby="templates-heading">
    <div class="container">
      <h2 id="templates-heading">{t('resources/templates_heading')}</h2>
      <LinkList field="resources/templates_list" />
    </div>
  </section>

  <section class="section" id="audio" aria-labelledby="audio-heading">
    <div class="container">
      <h2 id="audio-heading">{t('resources/audio_heading')}</h2>
      <Copy field="resources/audio_intro" />
      <AudioList field="resources/audio_guides" />

      <h3 style="margin-top: 2rem">{t('resources/food_heading')}</h3>
      <AudioList field="resources/food_audio" itemHeading="h4" />

      <h3 style="margin-top: 2rem">{t('resources/french_heading')}</h3>
      <Copy field="resources/french_copy" />
    </div>
  </section>

  <section class="section section--beige" id="narratives" aria-labelledby="narratives-heading">
    <div class="container">
      <h2 id="narratives-heading">{t('resources/narratives_heading')}</h2>
      <LinkList field="resources/narratives_list" />
    </div>
  </section>

  <section class="section" id="sites" aria-labelledby="sites-heading">
    <div class="container">
      <h2 id="sites-heading">{t('resources/helpful_sites_heading')}</h2>
      <Copy field="resources/helpful_sites_intro" />
      <LinkList field="resources/helpful_sites_list" />
    </div>
  </section>

  <ContactCta headingField="resources/ready_to_ride_heading" bodyField="resources/contact_cta" />
</BaseLayout>
