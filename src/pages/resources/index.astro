---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ContactCta from '../../components/ContactCta.astro';
import { COPY, TEXT } from '../../data/approved-copy';
import {
  AUDIO_GUIDES,
  FOOD_AUDIO,
  FRENCH_AUDIO_URL,
  NARRATIVES,
  TEMPLATES,
  TRUSTED_SITES,
} from '../../data/resources';

const { resources } = COPY;
// The BikeTourFrance.net resource library lives on its own subdomain (live, HTTP 200 on 2027-10-03).
const LIBRARY_URL = 'https://resources.biketourfrance.net/';
---

<BaseLayout
  path="/resources/"
  title={TEXT['/resources-x/p_1']}
  description={resources.metaDescription}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{TEXT['/nav/resources']}</p>
      <h1>{TEXT['/resources-page/heading_1']}</h1>
      <p class="lede">{resources.metaDescription}</p>
      <p>
        {TEXT['/resources-page/frag_1']} <a href="#templates">{TEXT['/resources-page/frag_2']}</a>, <a href="#audio">{TEXT['/resources-page/frag_3']}</a>,{' '}
        <a href="#narratives">{TEXT['/resources-page/heading_3']}</a>, <a href="#sites">{TEXT['/resources-page/on_page_sites_label']}</a>.
      </p>
      <div class="btn-row">
        <Button href="/" variant="tertiary">
          {resources.backLink}
        </Button>
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="stuff-heading">
    <div class="container">
      <h2 id="stuff-heading">{resources.helpfulStuffHeading}</h2>
      <p>{resources.helpfulStuffBody}</p>

      <h3 id="templates" class="subhead">
        {TEXT['/resources-page/frag_2']}
      </h3>
      <ul class="resource-list">
        {TEMPLATES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
            {item.note && <p class="note">{item.note}</p>}
          </li>
        ))}
      </ul>

      <h3 id="audio" class="subhead">{TEXT['/resources-page/heading_2']}</h3>
      <p>{TEXT['/resources-page/body_1']}</p>
      <ul class="resource-list">
        {AUDIO_GUIDES.map((item) => (
          <li class="audio-item">
            <p class="audio-title">{item.title}</p>
            <audio controls preload="none" src={item.url}>
              Your browser cannot play this audio. Use the download link instead.
            </audio>
            <a class="dl" href={item.url} download rel="noopener">
              Download {item.title}
            </a>
          </li>
        ))}
      </ul>

      <h3 class="subhead">{TEXT['/resources-page/frag_5']}</h3>
      <ul class="resource-list">
        <li class="audio-item">
          <p class="audio-title">{FOOD_AUDIO.title}</p>
          <audio controls preload="none" src={FOOD_AUDIO.url}>
            {TEXT['/resources-page/frag_6']}
          </audio>
          <a class="dl" href={FOOD_AUDIO.url} download rel="noopener">
            {TEXT['/resources-page/frag_7']} {FOOD_AUDIO.title}
          </a>
        </li>
      </ul>

      <h3 class="subhead">{TEXT['/resources-page/frag_8']}</h3>
      <p>
        {TEXT['/resources-page/frag_9']}{' '}
        <a href={FRENCH_AUDIO_URL} rel="noopener">
          {TEXT['/resources-page/frag_10']}
        </a>
        .
      </p>

      <h3 id="narratives" class="subhead">{TEXT['/resources-page/heading_3']}</h3>
      <ul class="resource-list">
        {NARRATIVES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
            {item.note && <p class="note">{item.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="sites" aria-labelledby="sites-heading">
    <div class="container">
      <h2 id="sites-heading">{resources.helpfulSitesHeading}</h2>
      <p>{resources.helpfulSitesBody}</p>
      <ul class="resource-list">
        {TRUSTED_SITES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
          </li>
        ))}
      </ul>

      <div class="library">
        <p>{resources.libraryText}</p>
        <div class="btn-row">
          <Button href={LIBRARY_URL}>{resources.libraryCta}</Button>
        </div>
      </div>
    </div>
  </section>

  <ContactCta
    heading={TEXT['/resources-x/p_2']}
    text={TEXT['/resources-x/p_3']}
  />
</BaseLayout>
