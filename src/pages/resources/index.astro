---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCta from '../../components/ContactCta.astro';
import {
  AUDIO_GUIDES,
  FOOD_AUDIO,
  FRENCH_AUDIO_URL,
  NARRATIVES,
  TEMPLATES,
  TRUSTED_SITES,
} from '../../data/resources';
---

<BaseLayout
  path="/resources/"
  title="Resources for planning a self-supported bike tour in France"
  description="Free planning resources from BikeTourFrance.net: a packing list template, audio route guides for the Canal des Deux Mers, a historical narrative, and trusted cycling and travel sites."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Resources</p>
      <h1>Resources for planning and riding</h1>
      <p class="lede">
        Planning a successful self-supported bike tour in France takes good structure. These are the
        templates, audio guides, and sites John uses and trusts. They are free. Change them to fit your trip.
      </p>
      <p>
        On this page: <a href="#templates">Templates</a>, <a href="#audio">Audio guides</a>,{' '}
        <a href="#narratives">Reading</a>, <a href="#sites">Trusted sites</a>.
      </p>
    </div>
  </section>

  <section class="section section--beige" id="templates" aria-labelledby="templates-heading">
    <div class="container">
      <h2 id="templates-heading">Templates</h2>
      <ul class="resource-list">
        {TEMPLATES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
            {item.note && <p class="note">{item.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="audio" aria-labelledby="audio-heading">
    <div class="container">
      <h2 id="audio-heading">Audio guides for the Canal des Deux Mers</h2>
      <p>
        A short history guide for each riding day, from Bordeaux to Sète. Press play to listen here, or
        download a file to listen offline. The files load only when you press play.
      </p>
      <ul class="resource-list">
        {AUDIO_GUIDES.map((item) => (
          <li class="audio-item">
            <h3 style="font-size: 1.05rem; margin: 0">{item.title}</h3>
            <audio controls preload="none" src={item.url}>
              Your browser cannot play this audio. Use the download link instead.
            </audio>
            <a class="dl" href={item.url} download rel="noopener">
              Download {item.title}
            </a>
          </li>
        ))}
      </ul>

      <h3 style="margin-top: 2rem">Food</h3>
      <ul class="resource-list">
        <li class="audio-item">
          <h4 style="font-size: 1.05rem; margin: 0">{FOOD_AUDIO.title}</h4>
          <audio controls preload="none" src={FOOD_AUDIO.url}>
            Your browser cannot play this audio. Use the download link instead.
          </audio>
          <a class="dl" href={FOOD_AUDIO.url} download rel="noopener">
            Download {FOOD_AUDIO.title}
          </a>
        </li>
      </ul>

      <h3 style="margin-top: 2rem">French practice</h3>
      <p>
        Simple French phrases to listen to and repeat are in the BikeTourFrance.net resource library:{' '}
        <a href={FRENCH_AUDIO_URL} rel="noopener">
          French learning audio
        </a>
        .
      </p>
    </div>
  </section>

  <section class="section section--beige" id="narratives" aria-labelledby="narratives-heading">
    <div class="container">
      <h2 id="narratives-heading">Reading</h2>
      <ul class="resource-list">
        {NARRATIVES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
            {item.note && <p class="note">{item.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="sites" aria-labelledby="sites-heading">
    <div class="container">
      <h2 id="sites-heading">Trusted cycling and travel sites</h2>
      <p>
        These are sites John trusts for accuracy, depth, and real-world relevance when planning bike tours.
      </p>
      <ul class="resource-list">
        {TRUSTED_SITES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactCta
    heading="Missing something?"
    text="Tell John what would make planning easier and he will consider adding it."
  />
</BaseLayout>
