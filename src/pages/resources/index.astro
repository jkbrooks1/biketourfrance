---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ContactCta from '../../components/ContactCta.astro';
import { COPY } from '../../data/approved-copy';
import {
  AUDIO_GUIDES,
  FOOD_AUDIO,
  FRENCH_AUDIO_URL,
  NARRATIVES,
  TEMPLATES,
  TRUSTED_SITES,
} from '../../data/resources';

const { resources } = COPY;
// The BikeTourFrance.net resource library lives on its own subdomain (live, HTTP 200 on 2026-10-03).
const LIBRARY_URL = 'https://resources.biketourfrance.net/';
---

<BaseLayout
  path="/resources/"
  title="Resources for planning a self-supported bike tour in France"
  description={resources.metaDescription}
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Resources</p>
      <h1>Resources for planning and riding</h1>
      <p class="lede">{resources.metaDescription}</p>
      <p>
        On this page: <a href="#templates">Templates</a>, <a href="#audio">Audio guides</a>,{' '}
        <a href="#narratives">Reading</a>, <a href="#sites">Helpful sites</a>.
      </p>
      <div class="btn-row">
        <Button href="/" variant="tertiary">
          {resources.backLink}
        </Button>
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="stuff-heading">
    <div class="container">
      <h2 id="stuff-heading">{resources.helpfulStuffHeading}</h2>
      <p>{resources.helpfulStuffBody}</p>

      <h3 id="templates" class="subhead">
        Templates
      </h3>
      <ul class="resource-list">
        {TEMPLATES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
            {item.note && <p class="note">{item.note}</p>}
          </li>
        ))}
      </ul>

      <h3 id="audio" class="subhead">
        Audio guides for the Canal des Deux Mers
      </h3>
      <p>
        A short history guide for each riding day, from Bordeaux to Sète. Press play to listen here, or
        download a file to listen offline. The files load only when you press play.
      </p>
      <ul class="resource-list">
        {AUDIO_GUIDES.map((item) => (
          <li class="audio-item">
            <p class="audio-title">{item.title}</p>
            <audio controls preload="none" src={item.url}>
              Your browser cannot play this audio. Use the download link instead.
            </audio>
            <a class="dl" href={item.url} download rel="noopener">
              Download {item.title}
            </a>
          </li>
        ))}
      </ul>

      <h3 class="subhead">Food</h3>
      <ul class="resource-list">
        <li class="audio-item">
          <p class="audio-title">{FOOD_AUDIO.title}</p>
          <audio controls preload="none" src={FOOD_AUDIO.url}>
            Your browser cannot play this audio. Use the download link instead.
          </audio>
          <a class="dl" href={FOOD_AUDIO.url} download rel="noopener">
            Download {FOOD_AUDIO.title}
          </a>
        </li>
      </ul>

      <h3 class="subhead">French practice</h3>
      <p>
        Simple French phrases to listen to and repeat are in the BikeTourFrance.net resource library:{' '}
        <a href={FRENCH_AUDIO_URL} rel="noopener">
          French learning audio
        </a>
        .
      </p>

      <h3 id="narratives" class="subhead">
        Reading
      </h3>
      <ul class="resource-list">
        {NARRATIVES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
            {item.note && <p class="note">{item.note}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="sites" aria-labelledby="sites-heading">
    <div class="container">
      <h2 id="sites-heading">{resources.helpfulSitesHeading}</h2>
      <p>{resources.helpfulSitesBody}</p>
      <ul class="resource-list">
        {TRUSTED_SITES.map((item) => (
          <li>
            <a class="title" href={item.url} rel="noopener">
              {item.title}
            </a>
          </li>
        ))}
      </ul>

      <div class="library">
        <p>{resources.libraryText}</p>
        <div class="btn-row">
          <Button href={LIBRARY_URL}>{resources.libraryCta}</Button>
        </div>
      </div>
    </div>
  </section>

  <ContactCta
    heading="Missing something?"
    text="Tell John what would make planning easier and he will consider adding it."
  />
</BaseLayout>
