---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import ContactCta from '../../components/ContactCta.astro';
import { COPY, TEXT } from '../../data/approved-copy';
import { PHOTOS } from '../../data/photos';

const { about } = COPY;
---

<BaseLayout
  path="/about/"
  title={TEXT['/about-page/meta_title']}
  description={TEXT['/about-page/meta_description']}
  ogImage={PHOTOS.threeRidersTown.src}
>
  <section class="section">
    <div class="container split">
      <div>
        <h1>{about.heading}</h1>
        <p class="lede">{about.subheading}</p>
        <p>{about.body1}</p>
        <p>{about.body2}</p>
        <p>{about.body3}</p>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.threeRidersTown.src}
          alt={PHOTOS.threeRidersTown.alt}
          priority
          ratio="1:1"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="how-heading">
    <div class="container">
      <h2 id="how-heading">{TEXT['/about-page/heading_1']}</h2>
      <p>{about.body4}</p>
      <p>{about.body5}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="who-heading">
    <div class="container">
      <h2 id="who-heading">{TEXT['/about-page/heading_2']}</h2>
      <p>{about.body6}</p>
      <p>{about.body7}</p>
    </div>
  </section>

  <ContactCta
    heading={TEXT['/about-x/p_1']}
    text={TEXT['/about-x/p_2']}
  />
</BaseLayout>
