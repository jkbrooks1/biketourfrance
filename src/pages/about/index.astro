---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import Copy from '../../components/Copy.astro';
import ContactCta from '../../components/ContactCta.astro';
import { PHOTOS } from '../../data/photos';
import { t } from '../../lib/copy.mjs';
---

<BaseLayout path="/about/" title={t('about/seo_title')} description={t('about/seo_description')}>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{t('about/page_eyebrow')}</p>
        <h1>{t('about/page_heading')}</h1>
        <Copy field="about/page_lede" class="lede" />
        <Copy field="about/intro_body" />
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.threeRidersTown.src}
          alt={PHOTOS.threeRidersTown.alt}
          priority
          sizes="(min-width: 820px) 45vw, 92vw"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="how-heading">
    <div class="container prose">
      <h2 id="how-heading">{t('about/how_heading')}</h2>
      <Copy field="about/how_body" />
    </div>
  </section>

  <section class="section" aria-labelledby="who-heading">
    <div class="container prose">
      <h2 id="who-heading">{t('about/who_heading')}</h2>
      <Copy field="about/who_body" />
    </div>
  </section>

  <ContactCta headingField="about/ready_to_ride_heading" bodyField="about/contact_cta" />
</BaseLayout>
