---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import ContactCta from '../../components/ContactCta.astro';
import { COPY } from '../../data/approved-copy';
import { PHOTOS } from '../../data/photos';

const { about } = COPY;
---

<BaseLayout
  path="/about/"
  title="About John Brooks"
  description="John Brooks leads small, self-supported bicycle tours in France. Learn who he is, how the tours work, and why he plans each day in detail."
  ogImage={PHOTOS.threeRidersTown.src}
>
  <section class="section">
    <div class="container split">
      <div>
        <h1>{about.heading}</h1>
        <p class="lede">{about.subheading}</p>
        <p>{about.body1}</p>
        <p>{about.body2}</p>
        <p>{about.body3}</p>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.threeRidersTown.src}
          alt={PHOTOS.threeRidersTown.alt}
          priority
          ratio="1:1"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="how-heading">
    <div class="container">
      <h2 id="how-heading">How the tours work</h2>
      <p>{about.body4}</p>
      <p>{about.body5}</p>
    </div>
  </section>

  <section class="section" aria-labelledby="who-heading">
    <div class="container">
      <h2 id="who-heading">Who is planning your trip</h2>
      <p>{about.body6}</p>
      <p>{about.body7}</p>
    </div>
  </section>

  <ContactCta
    heading="Want to talk it through?"
    text="Email John with your questions about the 2027 tours or about planning your own trip."
  />
</BaseLayout>
