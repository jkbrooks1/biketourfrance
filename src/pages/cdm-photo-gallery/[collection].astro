---
import galleryFont from '../../../node_modules/@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CdmPhotoGallery from '../../components/CdmPhotoGallery.astro';
import '../../styles/cdm-photo-gallery.css';
import { TEXT } from '../../data/approved-copy';
import { COLLECTIONS, GALLERY_ROOT, galleryPhotos, type Collection } from '../../data/cdm-photo-gallery';

export function getStaticPaths() {
  return COLLECTIONS.map((collection) => ({ params: { collection }, props: { collection } }));
}
interface Props { collection: Collection }
const { collection } = Astro.props;
const other = collection === 'cdm1' ? 'cdm2' : 'cdm1';
const count = galleryPhotos.filter((photo) => photo.collection === collection).length;
---

<BaseLayout path={`${GALLERY_ROOT}${collection}/`} title={TEXT[`/cdm-gallery-${collection}/meta_title`]} description={TEXT[`/cdm-gallery-${collection}/meta_description`]}>
  <link slot="head" rel="preload" href={galleryFont} as="font" type="font/woff2" crossorigin="anonymous" />
  <section class="section cdm-gallery-header">
    <div class="container">
      <h1>{TEXT[`/cdm-gallery/${collection}_heading`]}</h1>
      <p class="lede">{TEXT[`/cdm-gallery/${collection}_intro`]}</p>
      <p>{count} {TEXT['/cdm-gallery/photo_count_label']}</p>
      <nav class="cdm-gallery-links" aria-label={TEXT['/cdm-gallery/navigation_label']}>
        <a href={GALLERY_ROOT}>{TEXT['/cdm-gallery/back_link']}</a>
        <a href={`${GALLERY_ROOT}${other}/`}>{TEXT[`/cdm-gallery/${other}_link`]}</a>
      </nav>
    </div>
  </section>
  <div class="cdm-gallery-area">
    <CdmPhotoGallery collection={collection} />
  </div>
</BaseLayout>
