---
import galleryFont from '../../../node_modules/@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CdmPhotoGallery from '../../components/CdmPhotoGallery.astro';
import Button from '../../components/Button.astro';
import '../../styles/cdm-photo-gallery.css';
import { TEXT } from '../../data/approved-copy';
import { GALLERY_ROOT, galleryPhotos } from '../../data/cdm-photo-gallery';
---

<BaseLayout path={GALLERY_ROOT} title={TEXT['/cdm-gallery/meta_title']} description={TEXT['/cdm-gallery/meta_description']}>
  <link slot="head" rel="preload" href={galleryFont} as="font" type="font/woff2" crossorigin="anonymous" />
  <section class="section cdm-gallery-header">
    <div class="container">
      <h1>{TEXT['/cdm-gallery/heading']}</h1>
      <p class="lede">{TEXT['/cdm-gallery/cdm1_intro']}</p>
      <p>{galleryPhotos.length} {TEXT['/cdm-gallery/photo_count_label']}</p>
    </div>
  </section>
  <div class="cdm-gallery-area">
    <CdmPhotoGallery collection="combined" />
  </div>
  <section class="section" data-gallery-cta>
    <div class="container">
      <p class="lede">{TEXT['/cdm-gallery/future_tour_cta']}</p>
      <Button href="/waitlist-2027/">{TEXT['/waitlist/cta_1']}</Button>
    </div>
  </section>
</BaseLayout>
