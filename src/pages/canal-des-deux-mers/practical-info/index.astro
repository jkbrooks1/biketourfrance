---
import { TEXT } from '../../../data/approved-copy';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Photo from '../../../components/Photo.astro';
import ContactCta from '../../../components/ContactCta.astro';
import { PHOTOS } from '../../../data/photos';

const tramSummary = [
  TEXT['/cdm-practical/list_1'],
  TEXT['/cdm-practical/list_2'],
  TEXT['/cdm-practical/list_3'],
  TEXT['/cdm-practical/list_4'],
  TEXT['/cdm-practical/list_5'],
  TEXT['/cdm-practical/list_6'],
];
const busSummary = [
  TEXT['/cdm-practical/list_7'],
  TEXT['/cdm-practical/list_8'],
  TEXT['/cdm-practical/list_9'],
  TEXT['/cdm-practical/list_10'],
  TEXT['/cdm-practical/list_11'],
  TEXT['/cdm-practical/list_12'],
];
const tramChoose = [
  TEXT['/cdm-practical/list_13'],
  TEXT['/cdm-practical/list_14'],
  TEXT['/cdm-practical/list_15'],
  TEXT['/cdm-practical/list_16'],
];
const busChoose = [
  TEXT['/cdm-practical/list_17'],
  TEXT['/cdm-practical/list_18'],
  TEXT['/cdm-practical/list_19'],
  TEXT['/cdm-practical/list_20'],
];

const details = [
  { title: TEXT['/cdm-practical/q1_title'], tram: TEXT['/cdm-practical/q1_tram'], bus: TEXT['/cdm-practical/q1_bus'] },
  { title: TEXT['/cdm-practical/q2_title'], tram: TEXT['/cdm-practical/q2_tram'], bus: TEXT['/cdm-practical/q2_bus'] },
  { title: TEXT['/cdm-practical/q3_title'], tram: TEXT['/cdm-practical/q3_tram'], bus: TEXT['/cdm-practical/q3_bus'] },
  { title: TEXT['/cdm-practical/q4_title'], tram: TEXT['/cdm-practical/q4_tram'], bus: TEXT['/cdm-practical/q4_bus'] },
  { title: TEXT['/cdm-practical/q5_title'], tram: TEXT['/cdm-practical/q5_tram'], bus: TEXT['/cdm-practical/q5_bus'] },
  { title: TEXT['/cdm-practical/q6_title'], tram: TEXT['/cdm-practical/q6_tram'], bus: TEXT['/cdm-practical/q6_bus'] },
];
---

<BaseLayout
  path="/canal-des-deux-mers/practical-info/"
  title={TEXT['/cdm-practical/meta_title']}
  description={TEXT['/cdm-practical/meta_description']}
>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{TEXT['/nav/practical_info']}</p>
        <h1>{TEXT['/cdm-practical/heading_1']}</h1>
        <p class="lede">{TEXT['/cdm-practical/body_2']}</p>
        <div class="notice">
          <p>
            {TEXT['/cdm-practical/frag_1']} {TEXT['/cdm-practical/last_checked']}{TEXT['/cdm-practical/frag_2']}
          </p>
        </div>
      </div>
      <div class="rounded narrow-media">
        <Photo
          src={PHOTOS.pandaAirport.src}
          alt={PHOTOS.pandaAirport.alt}
          priority
          ratio="3:4"
          widths={[360, 540, 720]}
          sizes="(min-width: 768px) 360px, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="summary-heading">
    <div class="container">
      <h2 id="summary-heading">{TEXT['/cdm-practical/heading_2']}</h2>
      <div class="two-col">
        <div class="card">
          <h3>{TEXT['/cdm-practical/heading_3']}</h3>
          <ul>
            {tramSummary.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h3>{TEXT['/cdm-practical/heading_4']}</h3>
          <ul>
            {busSummary.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="choose-heading">
    <div class="container">
      <h2 id="choose-heading">{TEXT['/cdm-practical/heading_5']}</h2>
      <div class="two-col">
        <div class="card">
          <h3>{TEXT['/cdm-practical/heading_6']}</h3>
          <ul>
            {tramChoose.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h3>{TEXT['/cdm-practical/heading_7']}</h3>
          <ul>
            {busChoose.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="details-heading">
    <div class="container">
      <h2 id="details-heading">{TEXT['/cdm-practical/frag_3']}</h2>
      {details.map((d) => (
        <details class="card accordion">
          <summary>{d.title}</summary>
          <div class="two-col">
            <div>
              <h3>{TEXT['/cdm-practical/heading_3']}</h3>
              <p class="preline">{d.tram}</p>
            </div>
            <div>
              <h3>{TEXT['/cdm-practical/heading_4']}</h3>
              <p class="preline">{d.bus}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <ContactCta
    heading={TEXT['/canal-des-deux-mers-practical-info-x/p_1']}
    text={TEXT['/canal-des-deux-mers-practical-info-x/p_2']}
  />
</BaseLayout>
