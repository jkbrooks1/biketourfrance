---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Photo from '../../../components/Photo.astro';
import ContactCta from '../../../components/ContactCta.astro';
import practicalInfoData from '../../../data/practical-info-data.json';
import { PHOTOS } from '../../../data/photos';

// Data comes from the existing Practical Info sheet export (see docs/BUILD_LOG.md). Only the labels are cleaned up here.
const { questions, generated_at } = practicalInfoData;
const byQuestion = Object.fromEntries(
  questions.map((entry: { question: string; tram: string; shuttle: string }) => [entry.question, entry]),
);
const checked = new Date(generated_at).toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const tramSummary = [
  'Cost: €1.90',
  'Travel time: about 45 minutes',
  'Frequency: every 10–15 minutes',
  'Bike in a case: always allowed',
  'Tickets: TBM app or machines',
  'Best for: lowest cost and flexibility',
];
const busSummary = [
  'Cost: €9–10',
  'Travel time: about 30 minutes',
  'Schedule: limited window',
  'Bike in a case: accepted',
  'Tickets: online or onboard',
  'Best for: fastest public option',
];
const tramChoose = [
  'Lowest cost matters',
  'You arrive early or late',
  'You have a bike case',
  'You want flexibility',
];
const busChoose = [
  'Fastest journey matters',
  'You arrive during operating hours',
  'Extra cost is okay',
  'You want the simplest trip',
];

const details = [
  ['1. What is it?', 'What is it?'],
  ['2. How frequently does it run?', 'How often does it run?'],
  ['3. How long does it take?', 'How long does it take?'],
  ['4. How much does it cost?', 'How much does it cost?'],
  ['5. What about my bike?!?!', 'What about my bike?'],
  ['6. How do I book?', 'How do I book?'],
].map(([key, title]) => ({ title, tram: byQuestion[key]?.tram ?? '', bus: byQuestion[key]?.shuttle ?? '' }));
---

<BaseLayout
  path="/canal-des-deux-mers/practical-info/"
  title="Bordeaux Airport to Gare Saint-Jean: tram or airport bus"
  description="How to get from Bordeaux Airport (Mérignac) to Gare Saint-Jean station and nearby hotels: Tram Line F or the 30'Direct airport bus, with times, costs, and bike rules."
>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Practical information</p>
        <h1>Bordeaux Airport to Gare Saint-Jean and your hotel</h1>
        <p class="lede">
          Gare Saint-Jean is Bordeaux's main railway station. All recommended hotels are within about 500 m of
          the station.
        </p>
        <div class="notice">
          <p>
            Schedules and fares come from the transport operators and were last checked in {checked}. Confirm
            them with TBM and 30'Direct before you travel.
          </p>
        </div>
      </div>
      <div class="rounded narrow-media">
        <Photo
          src={PHOTOS.pandaAirport.src}
          alt={PHOTOS.pandaAirport.alt}
          priority
          ratio="3:4"
          widths={[360, 540, 720]}
          sizes="(min-width: 768px) 360px, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="summary-heading">
    <div class="container">
      <h2 id="summary-heading">Your two options</h2>
      <div class="two-col">
        <div class="card">
          <h3>Tram Line F</h3>
          <ul>
            {tramSummary.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h3>30'Direct airport bus</h3>
          <ul>
            {busSummary.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="choose-heading">
    <div class="container">
      <h2 id="choose-heading">Which should I choose?</h2>
      <div class="two-col">
        <div class="card">
          <h3>Choose Tram Line F if:</h3>
          <ul>
            {tramChoose.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="card">
          <h3>Choose the 30'Direct airport bus if:</h3>
          <ul>
            {busChoose.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="details-heading">
    <div class="container">
      <h2 id="details-heading">Details</h2>
      {details.map((d) => (
        <details class="card accordion">
          <summary>{d.title}</summary>
          <div class="two-col">
            <div>
              <h3>Tram Line F</h3>
              <p class="preline">{d.tram}</p>
            </div>
            <div>
              <h3>30'Direct airport bus</h3>
              <p class="preline">{d.bus}</p>
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <ContactCta
    heading="Questions about getting to Bordeaux?"
    text="Email John and he will help you plan your arrival."
  />
</BaseLayout>
