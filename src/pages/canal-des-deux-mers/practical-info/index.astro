---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Photo from '../../../components/Photo.astro';
import Copy from '../../../components/Copy.astro';
import ContactCta from '../../../components/ContactCta.astro';
import { PHOTOS } from '../../../data/photos';
import { t } from '../../../lib/copy.mjs';

// The six detail questions. Each has its own approved copy field for the question and for the
// tram and bus answers.
const details = [
  {
    questionField: 'practical-information/detail_1_question',
    tramField: 'practical-information/detail_1_tram',
    busField: 'practical-information/detail_1_bus',
  },
  {
    questionField: 'practical-information/detail_2_question',
    tramField: 'practical-information/detail_2_tram',
    busField: 'practical-information/detail_2_bus',
  },
  {
    questionField: 'practical-information/detail_3_question',
    tramField: 'practical-information/detail_3_tram',
    busField: 'practical-information/detail_3_bus',
  },
  {
    questionField: 'practical-information/detail_4_question',
    tramField: 'practical-information/detail_4_tram',
    busField: 'practical-information/detail_4_bus',
  },
  {
    questionField: 'practical-information/detail_5_question',
    tramField: 'practical-information/detail_5_tram',
    busField: 'practical-information/detail_5_bus',
  },
  {
    questionField: 'practical-information/detail_6_question',
    tramField: 'practical-information/detail_6_tram',
    busField: 'practical-information/detail_6_bus',
  },
];
---

<BaseLayout
  path="/canal-des-deux-mers/practical-info/"
  title={t('practical-information/seo_title')}
  description={t('practical-information/seo_description')}
>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{t('practical-information/page_eyebrow')}</p>
        <h1>{t('practical-information/page_heading')}</h1>
        <Copy field="practical-information/page_intro" class="lede" />
        <div class="notice">
          <Copy field="practical-information/data_notice" />
        </div>
      </div>
      <div class="rounded" style="max-width: 360px">
        <Photo
          src={PHOTOS.pandaAirport.src}
          alt={PHOTOS.pandaAirport.alt}
          priority
          widths={[360, 540, 720]}
          sizes="(min-width: 820px) 360px, 92vw"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="summary-heading">
    <div class="container">
      <h2 id="summary-heading">{t('practical-information/options_heading')}</h2>
      <div class="two-col">
        <div class="card">
          <h3>{t('practical-information/tram_heading')}</h3>
          <Copy field="practical-information/tram_summary" />
        </div>
        <div class="card">
          <h3>{t('practical-information/bus_heading')}</h3>
          <Copy field="practical-information/bus_summary" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="choose-heading">
    <div class="container">
      <h2 id="choose-heading">{t('practical-information/choose_heading')}</h2>
      <div class="two-col">
        <div class="card">
          <h3>{t('practical-information/tram_choose_heading')}</h3>
          <Copy field="practical-information/tram_choose" />
        </div>
        <div class="card">
          <h3>{t('practical-information/bus_choose_heading')}</h3>
          <Copy field="practical-information/bus_choose" />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="details-heading">
    <div class="container">
      <h2 id="details-heading">{t('practical-information/details_heading')}</h2>
      {details.map((d) => (
        <details class="card detail">
          <summary>{t(d.questionField)}</summary>
          <div class="two-col" style="margin-top: 12px">
            <div>
              <h3>{t('practical-information/tram_heading')}</h3>
              <Copy field={d.tramField} />
            </div>
            <div>
              <h3>{t('practical-information/bus_heading')}</h3>
              <Copy field={d.busField} />
            </div>
          </div>
        </details>
      ))}
    </div>
  </section>

  <ContactCta
    headingField="practical-information/ready_to_ride_heading"
    bodyField="practical-information/contact_cta"
  />
</BaseLayout>
