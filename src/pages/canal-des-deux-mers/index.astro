---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import Included from '../../components/Included.astro';
import Gallery from '../../components/Gallery.astro';
import Button from '../../components/Button.astro';
import { COPY, TEXT } from '../../data/approved-copy';
import {
  CDM_FACTS,
  CDM_STATS,
  SELF_SUPPORTED_POINTS,
  STOPS,
  TOULOUSE_DINNER,
  WEEK_PLAN,
} from '../../data/cdm2027';
import { GALLERY, PHOTOS } from '../../data/photos';
import { CONTACT_LINKS } from '../../data/site';
---

<BaseLayout
  path="/canal-des-deux-mers/"
  title={TEXT['/cdm/meta_title']}
  description={TEXT['/cdm/meta_description']}
>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{TEXT['/cdm/body_1']}</p>
        <h1>{TEXT['/cdm/heading_1']}</h1>
        <p class="lede">
          {CDM_FACTS.route} {TEXT['/cdm/frag_1']}
        </p>
        <div class="notice">
          <p>
            <strong>{TEXT['/cdm/frag_2']}</strong> {CDM_FACTS.departures} {CDM_FACTS.datesNote}{' '}
            {CDM_FACTS.pricingNote}
          </p>
        </div>
        <div class="btn-row">
          <Button href={CONTACT_LINKS.waitlist}>{COPY.hero.waitlistCta}</Button>
          <Button href={CONTACT_LINKS.general} variant="secondary">{TEXT['/cdm/cta_1']}</Button>
        </div>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.hero.src}
          alt={PHOTOS.hero.alt}
          priority
          ratio="16:9"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="at-a-glance">
    <div class="container">
      <h2 id="at-a-glance">{TEXT['/cdm/heading_2']}</h2>
      <ul class="stats">
        {CDM_STATS.map((s) => (
          <li>
            <strong>{s.value}</strong>
            {s.label}
          </li>
        ))}
      </ul>
      <ul>
        <li>{TEXT['/cdm/item_1']}</li>
        <li>
          {TEXT['/cdm-facts/group_size']}
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="route-heading">
    <div class="container">
      <h2 id="route-heading">{TEXT['/cdm/heading_3']}</h2>
      <p>{TEXT['/cdm/body_2']}</p>
      <ol class="stops" aria-label={TEXT['/cdm/aria_1']}>
        {STOPS.map((stop) => (
          <li>{stop}</li>
        ))}
      </ol>
      <h3>{TEXT['/cdm/heading_4']}</h3>
      <ul class="week">
        {WEEK_PLAN.map((step) => (
          <li>
            <strong>{step.day}</strong>
            <span>{step.text}</span>
          </li>
        ))}
      </ul>
      <h3>{TEXT['/cdm/heading_5']}</h3>
      <p>
        {TOULOUSE_DINNER.text} {TOULOUSE_DINNER.dress}
      </p>
    </div>
  </section>

  <section class="section section--beige">
    <div class="container">
      <Included />
    </div>
  </section>

  <section class="section" aria-labelledby="self-supported-heading">
    <div class="container two-col">
      <div>
        <h2 id="self-supported-heading">{TEXT['/cdm/heading_6']}</h2>
        <ul>
          {SELF_SUPPORTED_POINTS.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
        <p>
          <a href="/canal-des-deux-mers/practical-info/">
            {TEXT['/cdm/frag_3']}
          </a>
        </p>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.creon.src}
          alt={PHOTOS.creon.alt}
          ratio="3:4"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="history-heading">
    <div class="container">
      <h2 id="history-heading">{TEXT['/cdm/heading_7']}</h2>
      <p>
        {TEXT['/cdm/frag_4']} <a href="/resources/">{TEXT['/cdm/frag_5']}</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-heading">
    <div class="container">
      <h2 id="gallery-heading">{TEXT['/cdm/heading_8']}</h2>
      <Gallery photos={GALLERY} />
    </div>
  </section>
</BaseLayout>
