---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import Included from '../../components/Included.astro';
import Gallery from '../../components/Gallery.astro';
import ContactCta from '../../components/ContactCta.astro';
import Button from '../../components/Button.astro';
import { COPY } from '../../data/approved-copy';
import {
  CDM_FACTS,
  CDM_STATS,
  SELF_SUPPORTED_POINTS,
  STOPS,
  TOULOUSE_DINNER,
  WEEK_PLAN,
} from '../../data/cdm2027';
import { GALLERY, PHOTOS } from '../../data/photos';
import { CONTACT_LINKS } from '../../data/site';
---

<BaseLayout
  path="/canal-des-deux-mers/"
  title="Canal des Deux Mers by bike, 2027 small-group tour"
  description="Ride from Bordeaux to Sète along the Canal des Deux Mers with a small, self-supported group. Four departures in 2027: nine riding days, one rest day in Toulouse, 11 nights."
>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">2027 small-group tour</p>
        <h1>Canal des Deux Mers by bike, Bordeaux to Sète</h1>
        <p class="lede">
          {CDM_FACTS.route} Nine riding days, one rest day in Toulouse, and 11 nights, led by John Brooks.
        </p>
        <div class="notice">
          <p>
            <strong>Dates and pricing are not final.</strong> {CDM_FACTS.departures} {CDM_FACTS.datesNote}{' '}
            {CDM_FACTS.pricingNote}
          </p>
        </div>
        <div class="btn-row">
          <Button href={CONTACT_LINKS.waitlist}>{COPY.hero.waitlistCta}</Button>
          <Button href={CONTACT_LINKS.general} variant="secondary">
            Ask a question
          </Button>
        </div>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.hero.src}
          alt={PHOTOS.hero.alt}
          priority
          ratio="16:9"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="at-a-glance">
    <div class="container">
      <h2 id="at-a-glance">The tour at a glance</h2>
      <ul class="stats">
        {CDM_STATS.map((s) => (
          <li>
            <strong>{s.value}</strong>
            {s.label}
          </li>
        ))}
      </ul>
      <ul>
        <li>The route is the same on every departure.</li>
        <li>
          Groups run with a minimum of {CDM_FACTS.minRiders} riders. The target is {CDM_FACTS.targetRiders},
          and the maximum is {CDM_FACTS.maxRiders}.
        </li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="route-heading">
    <div class="container">
      <h2 id="route-heading">The route and the week</h2>
      <p>From the Atlantic to the Mediterranean, the tour passes through these stops:</p>
      <ol class="stops" aria-label="Route stops in order">
        {STOPS.map((stop) => (
          <li>{stop}</li>
        ))}
      </ol>
      <h3>How the week runs</h3>
      <ul class="week">
        {WEEK_PLAN.map((step) => (
          <li>
            <strong>{step.day}</strong>
            <span>{step.text}</span>
          </li>
        ))}
      </ul>
      <h3>Dinner in Toulouse</h3>
      <p>
        {TOULOUSE_DINNER.text} {TOULOUSE_DINNER.dress}
      </p>
    </div>
  </section>

  <section class="section section--beige">
    <div class="container">
      <Included />
    </div>
  </section>

  <section class="section" aria-labelledby="self-supported-heading">
    <div class="container two-col">
      <div>
        <h2 id="self-supported-heading">Self-supported means you carry your own gear</h2>
        <ul>
          {SELF_SUPPORTED_POINTS.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
        <p>
          <a href="/canal-des-deux-mers/practical-info/">
            Getting from Bordeaux Airport to the station and hotels
          </a>
        </p>
      </div>
      <div class="rounded">
        <Photo
          src={PHOTOS.creon.src}
          alt={PHOTOS.creon.alt}
          ratio="3:4"
          sizes="(min-width: 768px) 45vw, calc(100vw - 40px)"
        />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="history-heading">
    <div class="container">
      <h2 id="history-heading">Earlier tours on this route</h2>
      <p>
        BikeTourFrance.net rode the Canal des Deux Mers in September 2026. That tour is finished and is not
        open for booking. The audio route guides and a historical narrative written for it are still useful
        for planning, and they live on the <a href="/resources/">Resources page</a>.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-heading">
    <div class="container">
      <h2 id="gallery-heading">Photos from the route</h2>
      <Gallery photos={GALLERY} />
    </div>
  </section>

  <ContactCta />
</BaseLayout>
