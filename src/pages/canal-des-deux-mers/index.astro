---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import Copy from '../../components/Copy.astro';
import Included from '../../components/Included.astro';
import Gallery from '../../components/Gallery.astro';
import ContactCta from '../../components/ContactCta.astro';
import { GALLERY, PHOTOS } from '../../data/photos';
import { CONTACT_LINKS } from '../../data/site';
import { t } from '../../lib/copy.mjs';
---

<BaseLayout
  path="/canal-des-deux-mers/"
  title={t('cdm-tour/seo_title')}
  description={t('cdm-tour/seo_description')}
>
  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">{t('cdm-tour/hero_eyebrow')}</p>
        <h1>{t('cdm-tour/hero_heading')}</h1>
        <Copy field="cdm-tour/hero_body" class="lede" />
        <div class="notice">
          <Copy field="cdm-tour/dates_pricing_notice" />
        </div>
        <div class="btn-row">
          <a class="btn" href={CONTACT_LINKS.waitlist}>
            {t('site/cta_waitlist_label')}
          </a>
          <a class="btn btn--secondary" href={CONTACT_LINKS.general}>
            {t('cdm-tour/hero_cta_question')}
          </a>
        </div>
      </div>
      <div class="rounded">
        <Photo src={PHOTOS.hero.src} alt={PHOTOS.hero.alt} priority sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="at-a-glance">
    <div class="container">
      <h2 id="at-a-glance">{t('cdm-tour/glance_heading')}</h2>
      <Copy field="cdm-tour/glance_stats" listClass="stats" />
      <Copy field="cdm-tour/glance_points" />
    </div>
  </section>

  <section class="section" aria-labelledby="route-heading">
    <div class="container">
      <h2 id="route-heading">{t('cdm-tour/route_heading')}</h2>
      <Copy field="cdm-tour/route_intro" />
      <Copy field="cdm-tour/route_stops" listClass="stops" />
      <h3>{t('cdm-tour/week_heading')}</h3>
      <Copy field="cdm-tour/week_plan" listClass="week" />
      <h3>{t('cdm-tour/toulouse_dinner_heading')}</h3>
      <Copy field="cdm-tour/toulouse_dinner" />
    </div>
  </section>

  <section class="section section--beige">
    <div class="container">
      <Included
        headingField="cdm-tour/whats_included_heading"
        noticeField="cdm-tour/whats_included_notice"
        includedLabelField="cdm-tour/whats_included_label"
        includedField="cdm-tour/whats_included"
        separateLabelField="cdm-tour/what_you_arrange_separately_label"
        separateField="cdm-tour/what_you_arrange_separately"
      />
    </div>
  </section>

  <section class="section" aria-labelledby="self-supported-heading">
    <div class="container two-col">
      <div>
        <h2 id="self-supported-heading">{t('cdm-tour/self_supported_heading')}</h2>
        <Copy field="cdm-tour/self_supported_points" />
        <p>
          <a href="/canal-des-deux-mers/practical-info/">{t('cdm-tour/practical_link')}</a>
        </p>
      </div>
      <div class="rounded">
        <Photo src={PHOTOS.creon.src} alt={PHOTOS.creon.alt} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <section class="section section--beige" aria-labelledby="history-heading">
    <div class="container">
      <h2 id="history-heading">{t('cdm-tour/history_heading')}</h2>
      <Copy field="cdm-tour/history_body" />
    </div>
  </section>

  <section class="section" aria-labelledby="gallery-heading">
    <div class="container">
      <h2 id="gallery-heading">{t('cdm-tour/gallery_heading')}</h2>
      <Gallery photos={GALLERY} />
    </div>
  </section>

  <ContactCta headingField="cdm-tour/ready_to_ride_heading" bodyField="cdm-tour/contact_cta" />
</BaseLayout>
