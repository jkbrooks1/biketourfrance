---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Copy from '../../components/Copy.astro';
import { CONTACT_LINKS } from '../../data/site';
import { t } from '../../lib/copy.mjs';
---

<BaseLayout path="/contact/" title={t('contact/seo_title')} description={t('contact/seo_description')}>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">{t('contact/page_eyebrow')}</p>
      <h1>{t('contact/page_heading')}</h1>
      <Copy field="contact/page_lede" class="lede" />
      <p>
        <a class="btn" href={CONTACT_LINKS.general}>
          {t('site/cta_email_label')}
        </a>
      </p>

      <h2>{t('contact/starting_heading')}</h2>
      <Copy field="contact/starting_list" />
      <Copy field="contact/starting_note" />

      <h2>{t('contact/lists_heading')}</h2>
      <Copy field="contact/lists_body" />
    </div>
  </section>
</BaseLayout>
