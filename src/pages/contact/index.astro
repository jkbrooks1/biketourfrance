---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { COPY, TEXT } from '../../data/approved-copy';
import { CONTACT_LINKS, SITE } from '../../data/site';
---

<BaseLayout
  path="/contact/"
  title={TEXT['/contact-page/meta_title']}
  description={TEXT['/contact-page/meta_description']}
>
  <section class="section">
    <div class="container prose">
      <h1>{TEXT['/contact-page/meta_title']}</h1>
      <p>
        {TEXT['/contact-page/frag_1']} <a href={CONTACT_LINKS.general}>{SITE.email}</a>{TEXT['/contact-page/frag_2']}
      </p>
      <div class="btn-row">
        <Button href={CONTACT_LINKS.general}>{COPY.contact.emailCta}</Button>
      </div>

      <h2>{TEXT['/contact-page/heading_2']}</h2>
      <ul class="link-list">
        <li>
          <a href={CONTACT_LINKS.waitlist}>{TEXT['/contact-page/frag_3']}</a>
        </li>
        <li>
          <a href={CONTACT_LINKS.planning}>{TEXT['/contact-page/frag_4']}</a>
        </li>
        <li>
          <a href={CONTACT_LINKS.general}>{TEXT['/contact-page/frag_5']}</a>
        </li>
      </ul>
      <p>
        {TEXT['/contact-page/frag_6']} {TEXT['/contact-page/frag_7']}
      </p>

      <h2>{TEXT['/contact-page/heading_3']}</h2>
      <p>{TEXT['/contact-page/body_2']}</p>
    </div>
  </section>
</BaseLayout>
