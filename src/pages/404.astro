---
// Cloudflare Pages serves dist/404.html with HTTP 404 for unknown paths.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { COPY } from '../data/approved-copy';
import { NAV } from '../data/site';

const defaultNotFound = {
  heading: 'Page not found',
  body: 'We could not find that page. It may have moved, or the link may be mistyped.',
  homeCta: 'Back to the home page',
  resourcesCta: 'Resources',
  footerNote: 'Staging site. Not indexed.',
};

const notFound = (COPY && COPY.notFound && typeof COPY.notFound === 'object')
  ? COPY.notFound
  : defaultNotFound;
---

<BaseLayout
  path="/404/"
  notFound
  title={notFound.heading}
  description="That page is not on the BikeTourFrance.net website. Use these links to find the tour, resources, or contact page."
>
  <section class="section">
    <div class="container">
      <h1>{notFound.heading}</h1>
      <p class="lede">{notFound.body}</p>
      <p>These pages can help:</p>
      <ul class="link-list">
        {NAV.filter((item) => item.href !== '/').map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="btn-row">
        <Button href="/">{notFound.homeCta}</Button>
        <Button href="/resources/" variant="secondary">
          {notFound.resourcesCta}
        </Button>
      </div>
      <p class="page-note">{notFound.footerNote}</p>
    </div>
  </section>
</BaseLayout>
