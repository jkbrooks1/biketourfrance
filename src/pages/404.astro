---
// Cloudflare Pages serves dist/404.html with HTTP 404 for unknown paths.
import BaseLayout from '../layouts/BaseLayout.astro';
import Copy from '../components/Copy.astro';
import { NAV } from '../data/site';
import { t } from '../lib/copy.mjs';
---

<BaseLayout path="/404/" notFound title={t('404/seo_title')} description={t('404/seo_description')}>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{t('404/eyebrow')}</p>
      <h1>{t('404/heading')}</h1>
      <Copy field="404/body" class="lede" />
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href}>{t(item.field)}</a>
          </li>
        ))}
      </ul>
      <div class="btn-row">
        <a class="btn" href="/">
          {t('404/home_button')}
        </a>
        <a class="btn btn--secondary" href="/canal-des-deux-mers/">
          {t('404/tour_button')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
