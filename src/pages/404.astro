---
// Cloudflare Pages serves dist/404.html with HTTP 404 for unknown paths.
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../data/site';
---

<BaseLayout
  path="/404/"
  notFound
  title="Page not found"
  description="That page is not on the BikeTourFrance.net website. Use these links to find the tour, resources, or contact page."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>We could not find that page</h1>
      <p class="lede">The link may be old, or the page may have moved. These pages can help:</p>
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="btn-row">
        <a class="btn" href="/">
          Go to the home page
        </a>
        <a class="btn btn--secondary" href="/canal-des-deux-mers/">
          See the 2027 tour
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
