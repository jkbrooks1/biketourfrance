---
// Cloudflare Pages serves dist/404.html with HTTP 404 for unknown paths.
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { COPY, TEXT } from '../data/approved-copy';
import { NAV } from '../data/site';

const { notFound } = COPY;
---

<BaseLayout
  path="/404/"
  notFound
  title={notFound.heading}
  description={TEXT['/404-page/meta_description']}
>
  <section class="section">
    <div class="container">
      <h1>{notFound.heading}</h1>
      <p class="lede">{notFound.body}</p>
      <p>{TEXT['/404-page/body_1']}</p>
      <ul class="link-list">
        {NAV.filter((item) => item.href !== '/').map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
      <div class="btn-row">
        <Button href="/">{notFound.homeCta}</Button>
        <Button href="/resources/" variant="secondary">
          {notFound.resourcesCta}
        </Button>
      </div>
      <p class="page-note">{notFound.footerNote}</p>
    </div>
  </section>
</BaseLayout>
